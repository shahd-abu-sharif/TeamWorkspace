DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tadreeby?schema=public
PORT=3000
JWT_ACCESS_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=30d
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Refresh-cookie attributes. Defaults: dev -> SameSite=Lax, production ->
# SameSite=None; Secure (needed when the web app is hosted on a different
# domain than the API, e.g. Vercel + Render). If the web app proxies /api to
# this server, both are same-origin and COOKIE_SAMESITE=lax is the safer pick.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# Optional push notification settings
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional S3-compatible storage settings.
# Without S3_BUCKET uploads are written to the container disk, which is wiped on
# every deploy (files then download as 404 "no longer available").
# Works with AWS S3, Cloudflare R2 and Supabase Storage (set S3_ENDPOINT for the
# last two, plus S3_FORCE_PATH_STYLE=true if the provider requires path style).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# With no S3 bucket, uploads are stored in Postgres (FileBlob) and survive
# deploys. Nothing is ever written to the container's temporary disk.
